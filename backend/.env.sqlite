APP_NAME=SEALINK Attendance API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-this-with-a-long-random-secret-before-use
TOKEN_EXPIRE_SECONDS=3600
INITIAL_ADMIN_PASSWORD=replace-this-with-a-strong-initial-password
INITIAL_USER_PASSWORD=replace-this-with-a-strong-initial-password

# SQLite portable — không cần Docker, không cần cài PostgreSQL
DATABASE_URL=sqlite:///./sealink_attendance.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://26.199.241.193:5173,http://26.199.241.193:5174
