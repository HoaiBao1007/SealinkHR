APP_NAME=SEALINK Attendance API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_EXPIRE_SECONDS=3600
INITIAL_ADMIN_PASSWORD=set-a-strong-initial-password-on-first-setup
INITIAL_USER_PASSWORD=set-a-strong-initial-password-for-new-user-accounts

# ── Database — choose ONE mode ─────────────────────────────────────

# MODE 1: SQLite (portable default — no server needed)
#   Copy .env.sqlite -> .env  and run start-portable.ps1
DATABASE_URL=sqlite:///./sealink_attendance.db

# MODE 2: MariaDB/MySQL (required for the Windows Server deployment)
#   Copy .env.xampp -> .env  and run start-xampp.ps1
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/sealink_payroll_db?charset=utf8mb4

# Production example: replace every placeholder only in the server's private .env file.
# DATABASE_URL=mysql+pymysql://sealink_app:REPLACE_WITH_A_STRONG_PASSWORD@127.0.0.1:3306/sealink_hr?charset=utf8mb4

# ──────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://26.199.241.193:5173,http://26.199.241.193:5174

