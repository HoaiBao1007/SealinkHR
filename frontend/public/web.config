<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
    </staticContent>

    <!--
      The HR frontend is a client-side application. IIS must return the app
      shell for routes such as /login instead of looking for a physical file.

      This uses IIS' built-in custom error handling, so it does not depend on
      the optional URL Rewrite/ARR modules. Vite copies this file to dist on
      every production build.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
